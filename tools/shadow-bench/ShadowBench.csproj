<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console benchmark for node shadows, not a test and not part of DIR.Lib.sln. Paints 3 shadowed rounded cards and
    30 shadowed rows at 1280x800 through RgbaImageRenderer, shadows off then on, and prints the mean frame time.
    Run with dotnet run, project tools/shadow-bench, configuration Release.
    Sits outside src/ so Central Package Management does not apply.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DIR.Lib/DIR.Lib.csproj" />
  </ItemGroup>

</Project>
