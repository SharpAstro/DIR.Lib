<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regenerates src/DIR.Lib.Tests/RadicalJoinTests.Before.cs: the square root as it was BEFORE the
    radical-join rework (commit e6778fc; generate.ps1 says why that one), measured at every point
    RadicalJoinTests sweeps.

    It builds against a copy of that commit's sources, not against src/: the point of the data is what
    the old SqrtBox did. generate.ps1 beside this file extracts the copy, patches the old SqrtBox to
    report where it drew its bar, and runs this project against it. Run that script, not this project:
      pwsh tools/gen-radical-join-before/generate.ps1

    Like gen-emoji-presentation it is a repo tool: it stays out of src/ and out of the solution, and the
    table it writes is committed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Reflection over the old boxes' private fields; this tool is never trimmed or AOT-compiled. -->
    <NoWarn>$(NoWarn);IL2026;IL2075;IL2080</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(BaseTree)\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>

</Project>
