<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <!-- Never shipped, like the tests and the source generator. The publish step pushes
         **/*.nupkg, so a project that joins the solution states this rather than relying on
         the absence of GeneratePackageOnBuild. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The display-math corpus MathRasterCacheTests renders with the raster caches on and off, so the
         MathRaster benchmark times the formulas the test pins. It finds the fixture fonts in the source tree. -->
    <Compile Include="..\DIR.Lib.Tests\MathRasterCorpus.cs" Link="MathRasterCorpus.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The markdown parse corpus loader, shared with MarkdownCorpusGoldenTests so the benchmark
         times the documents whose AST the test pins. It finds the fixtures in the source tree. -->
    <Compile Include="..\DIR.Lib.Tests\MarkdownCorpus.cs" Link="MarkdownCorpus.cs" />
  </ItemGroup>

</Project>
